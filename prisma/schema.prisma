// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ActionLogType {
  CREATE
  UPDATE
  DELETE
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

enum ExperimentAllocationMode {
  FIXED
  BANDIT
}

enum ExperimentTargetType {
  USER
  FEATURE
  PAGE
}

enum ExperimentDeviceType {
  ANY
  MOBILE
  DESKTOP
  TABLET
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  memberships  Membership[]
  createdFlags FeatureFlag[] @relation("FeatureFlagCreatedBy")
  updatedFlags FeatureFlag[] @relation("FeatureFlagUpdatedBy")
  apiKeys      ApiKey[]      @relation("ApiKeyCreatedBy")
  environments Environment[] @relation("EnvironmentCreatedBy")
  createdExperiments Experiment[] @relation("ExperimentCreatedBy")
  updatedExperiments Experiment[] @relation("ExperimentUpdatedBy")
  actionLogs   ActionLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  memberships  Membership[]
  roles        Role[]
  permissions  Permission[]
  featureFlags FeatureFlag[]
  apiKeys      ApiKey[]
  environments Environment[]
  experiments  Experiment[]
  experimentEvents ExperimentEvent[]
  experimentAssignments ExperimentAssignment[]
  actionLogs   ActionLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  tenantId  String
  status    MembershipStatus @default(ACTIVE)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId, status, id])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     MembershipRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  tenantId    String
  resource    String
  action      String
  description String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, resource, action])
  @@index([tenantId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  id           String     @id @default(cuid())
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([membershipId, roleId])
  @@index([roleId])
}

model FeatureFlag {
  id              String   @id @default(cuid())
  tenantId        String
  environmentId   String
  key             String
  name            String
  description     String?
  allowListEmails Json?
  deletedAt       DateTime?
  enabled         Boolean  @default(false)
  rolloutPercent  Int      @default(0)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("FeatureFlagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy   User?       @relation("FeatureFlagUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  experiments Experiment[]

  @@unique([tenantId, environmentId, key])
  @@index([tenantId, environmentId, enabled])
}

model ApiKey {
  id                   String   @id @default(cuid())
  tenantId             String
  environmentId        String
  name                 String
  keyPrefix            String
  secretHash           String
  canReadFeatureFlags  Boolean  @default(true)
  canWriteFeatureFlags Boolean  @default(false)
  canReadEnvironments  Boolean  @default(false)
  canWriteEnvironments Boolean  @default(false)
  canReadProjects      Boolean  @default(false)
  canWriteProjects     Boolean  @default(false)
  enabled              Boolean  @default(true)
  lastUsedAt           DateTime?
  deletedAt            DateTime?
  createdByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, environmentId, enabled])
  @@index([tenantId, deletedAt, id])
  @@index([tenantId, secretHash, deletedAt])
  @@unique([secretHash])
}

model Environment {
  id              String   @id @default(cuid())
  tenantId        String
  key             String
  name            String
  description     String?
  enabled         Boolean  @default(true)
  createdByUserId String?
  featureFlags    FeatureFlag[]
  apiKeys         ApiKey[]
  experiments     Experiment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("EnvironmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([tenantId, enabled])
  @@index([tenantId, id])
}

model Experiment {
  id                    String                    @id @default(cuid())
  tenantId              String
  environmentId         String
  featureFlagId         String?
  key                   String
  name                  String
  description           String?
  status                ExperimentStatus          @default(DRAFT)
  allocationMode        ExperimentAllocationMode  @default(FIXED)
  targetType            ExperimentTargetType      @default(USER)
  targetValue           String?
  segmentCountry        String?
  segmentDevice         ExperimentDeviceType      @default(ANY)
  stickyBucketing       Boolean                   @default(true)
  gradualRolloutEnabled Boolean                   @default(false)
  rolloutPercent        Int                       @default(100)
  autoStart             Boolean                   @default(false)
  autoStop              Boolean                   @default(false)
  startAt               DateTime?
  endAt                 DateTime?
  goalEventName         String                    @default("signup_completed")
  guardrailMaxErrorRate Float?
  guardrailMinRevenue   Float?
  deletedAt             DateTime?
  createdByUserId       String?
  updatedByUserId       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  environment Environment          @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag?         @relation(fields: [featureFlagId], references: [id], onDelete: SetNull)
  createdBy   User?                @relation("ExperimentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy   User?                @relation("ExperimentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  variants    ExperimentVariant[]
  assignments ExperimentAssignment[]
  events      ExperimentEvent[]

  @@unique([tenantId, environmentId, key])
  @@index([tenantId, environmentId, status])
  @@index([tenantId, deletedAt, id])
}

model ExperimentVariant {
  id          String   @id @default(cuid())
  experimentId String
  key         String
  name        String
  trafficPercent Int
  isControl   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  experiment  Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assignments ExperimentAssignment[]
  events      ExperimentEvent[]

  @@unique([experimentId, key])
  @@index([experimentId, trafficPercent])
}

model ExperimentAssignment {
  id          String   @id @default(cuid())
  tenantId    String
  experimentId String
  variantId   String
  userKey     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  experiment  Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant     ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, userKey])
  @@index([tenantId, experimentId, variantId])
}

model ExperimentEvent {
  id            String   @id @default(cuid())
  tenantId      String
  experimentId  String
  variantId     String?
  userKey       String?
  eventName     String
  pagePath      String?
  featureKey    String?
  country       String?
  device        ExperimentDeviceType @default(ANY)
  revenue       Float?
  metadata      Json?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  experiment  Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant     ExperimentVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, experimentId, occurredAt])
  @@index([tenantId, eventName, occurredAt])
  @@index([tenantId, variantId, occurredAt])
}

model ActionLog {
  id         String        @id @default(cuid())
  tenantId   String
  userId     String?
  actionType ActionLogType
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, createdAt])
  @@index([userId, createdAt])
}
